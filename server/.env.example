# --- Groq LLM ---
# GROQ_API_KEY=${GROQ_API_KEY}

# --- MongoDB ---
# MONGODB_URI=${MONGODB_URI}

# --- JWT Secret ---
# SECRET_KEY=${SECRET_KEY}

# --- Cloudinary (Cloud File Storage) ---
# CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}
# CLOUDINARY_API_KEY=${CLOUDINARY_API_KEY}
# CLOUDINARY_API_SECRET=${CLOUDINARY_API_SECRET}

# --- HuggingFace Inference API (for embeddings) ---
# HF_TOKEN=${HF_TOKEN}

# --- Embeddings Mode ---
# Use 'api' (default) for HuggingFace Inference API — RAM-optimized for production.
# Use 'local' to force offline local embeddings in development (requires torch + sentence-transformers).
# EMBEDDINGS_MODE=api

# --- CORS Allowed Origins ---
# Comma-separated list of frontend origins allowed to call this API.
# In production, set this to your Vercel deployment URL(s).
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
