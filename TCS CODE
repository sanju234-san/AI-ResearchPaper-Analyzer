      "source": [
        "# palindrome number\n",
        "n = int(input(\"Enter a number: \"))\n",
        "original = n\n",
        "reverse = 0\n",
        "while n > 0 :\n",
        "    digit = n % 10\n",
        "    reverse = reverse * 10 + digit\n",
        "    n = n // 10\n",
        "if original == reverse :\n",
        "    print(original, \"is a palindrome number\")\n",
        "else :\n",
        "    print(original, \"is not a palindrome number\")"
      ]
